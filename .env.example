# Variables de entorno para el backend proxy
# Copia este archivo como .env y configura tus claves API

# API Key de Claude AI (obtén la tuya en https://console.anthropic.com/)
CLAUDE_API_KEY=tu_claude_api_key_aqui

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Entorno (development/production)
NODE_ENV=development